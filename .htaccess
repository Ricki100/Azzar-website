# ==================================================
# Azzar Fencing & Steel — Clean URLs (remove .html)
# ==================================================

RewriteEngine On

# Avoid Apache's MultiViews content negotiation interfering with the rules below
Options -MultiViews

# 1. If someone requests /page.html directly, 301-redirect to /page
#    (keeps a single canonical URL per page for SEO, avoids duplicate content)
RewriteCond %{THE_REQUEST} \s/+(.+?)\.html[\s?] [NC]
RewriteRule ^ /%1 [R=301,L]

# 2. Internally serve the matching .html file when /page is requested,
#    without the .html ever showing in the browser's address bar
RewriteCond %{REQUEST_FILENAME} !-d
RewriteCond %{REQUEST_FILENAME}\.html -f
RewriteRule ^(.*?)/?$ $1.html [L]

# 3. Blog posts: /blog/<slug>/ serves blog/post.html internally (post.html
#    reads the slug back out of the URL and looks it up in Supabase).
#    Slug pattern matches the schema.sql check constraint on content_items.slug.
RewriteRule ^blog/([a-z0-9]+(?:-[a-z0-9]+)*)/?$ blog/post.html [L]

# Baseline browser security and privacy headers (requires mod_headers).
<IfModule mod_headers.c>
  Header always set X-Content-Type-Options "nosniff"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set Permissions-Policy "camera=(), microphone=(), geolocation=()"
  Header always set X-Frame-Options "SAMEORIGIN"
  Header always set Strict-Transport-Security "max-age=31536000; includeSubDomains"
  Header always set Content-Security-Policy "default-src 'self'; script-src 'self' https://www.googletagmanager.com https://www.clarity.ms https://cdn.jsdelivr.net; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com https://cdn.jsdelivr.net; font-src 'self' https://fonts.gstatic.com https://cdn.jsdelivr.net; img-src 'self' data: https:; media-src 'self' https:; frame-src https://www.facebook.com https://drive.google.com; connect-src 'self' https://idwtldsvwdsxyddrmued.supabase.co https://hook.eu1.make.com https://api.web3forms.com https://www.google-analytics.com https://analytics.google.com https://www.clarity.ms https://c.clarity.ms; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'self'; upgrade-insecure-requests"
</IfModule>

# Custom 404 (optional — point this at a real error page if/when one exists)
# ErrorDocument 404 /404.html
